{
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true,
    "useTabs": false,
    "tabWidth": 2,
    "printWidth": 175,
    "arrowParens": "always",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindConfig": "./tailwind.config.js",
    "htmlWhitespaceSensitivity": "css" 
  }
  